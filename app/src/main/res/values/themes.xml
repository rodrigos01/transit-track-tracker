<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NJTTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@color/njt_blue</item>
    </style>

    <style name="Theme.NJTTracker.Starting" parent="Theme.NJTTracker">
        <!-- For API 31+ Splash Screen API -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/njt_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/njt_blue</item>
    </style>
</resources>
